[Unit]
Description=Avahi Manager privileged helper
Requires=avahi-manager-helper.socket
After=avahi-manager-helper.socket dbus.service
PartOf=avahi-manager.service
Before=avahi-manager.service

# Start/stop together with the web service so a stopped manager never leaves a
# live root helper waiting on a socket the web process cannot reach.
[Service]
Type=exec
User=root
Group=root

# Socket-activated: the helper binds the already-created Unix socket from
# avahi-manager-helper.socket. It must run as root; it performs privileged
# writes to /etc/avahi, systemd control and snapshot management.
ExecStart=@@BINARY_PATH@@ helper \
    --manager-user @@USER@@ \
    --config-dir @@AVAHI_CONFIG_DIR@@ \
    --backups @@BACKUPS_DIR@@ \
    --socket @@SOCKET_PATH@@

Restart=on-failure
RestartSec=5s

# Hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=true
# /etc/systemd/system is writable so the GUI's Enable/Disable Avahi (which
# creates/removes symlinks via EnableUnitFiles) can work from the helper.
ReadWritePaths=@@AVAHI_CONFIG_DIR@@ @@BACKUPS_DIR@@ /etc/systemd/system /run/avahi-manager
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
